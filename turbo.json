{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "ENVIRONMENT",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "OPENAI_VISION_MODEL",
    "OPENAI_REQUEST_TIMEOUT_S",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_PRIME_PRICE_ID",
    "STRIPE_PRIME_PRICE_ID_SAR",
    "STRIPE_PRIME_PRICE_ID_USD",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "PADDLE_API_KEY",
    "PADDLE_WEBHOOK_SECRET",
    "PADDLE_PRIME_PRICE_ID",
    "NEXT_PUBLIC_PADDLE_CLIENT_TOKEN",
    "UPSTASH_REDIS_URL",
    "UPSTASH_REDIS_TOKEN",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY",
    "SENTRY_DSN",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_APP_NAME",
    "ADMIN_APP_URL",
    "WEB_APP_URL",
    "AI_SERVICE_URL",
    "AI_SERVICE_INTERNAL_TOKEN",
    "AI_RATE_LIMIT_FREE",
    "AI_RATE_LIMIT_PRIME",
    "AI_CORS_ALLOW_ORIGINS",
    "PDF_SERVICE_URL",
    "PDF_SERVICE_INTERNAL_TOKEN",
    "EXPORT_LIMIT_FREE_PER_DAY",
    "EXPORT_LIMIT_PRIME_PER_DAY",
    "RENDER_INTERNAL_TOKEN",
    "PDF_RENDER_ALLOWED_EXTRA_HOSTS",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "CRON_SECRET",
    "ADMIN_INTERNAL_TOKEN",
    "ADMIN_BOOTSTRAP_EMAIL",
    "ADMIN_BOOTSTRAP_PASSWORD",
    "ADMIN_SESSION_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
