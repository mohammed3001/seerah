# =============================================================================
# Seerah — Environment Variables (example)
# Copy to `.env.local` (Next.js apps) or `.env` (services) and fill in values.
# Never commit real secrets to source control.
# =============================================================================

# ----- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=سيرة

# ----- Supabase (PostgreSQL + Auth + Storage + Realtime) --------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Anthropic (Claude API) ----------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ----- Stripe (subscriptions / billing) ------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRIME_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ----- Paddle (MENA payments fallback) -------------------------------------
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRIME_PRICE_ID=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# ----- Upstash Redis (cache / rate limiting) -------------------------------
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ----- Inngest (background jobs / queue) -----------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ----- Sentry (error tracking) ---------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ----- PostHog (product analytics) -----------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ----- AI service (FastAPI) ------------------------------------------------
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_INTERNAL_TOKEN=

# ----- PDF service (FastAPI + Puppeteer/WeasyPrint) ------------------------
PDF_SERVICE_URL=http://localhost:8002
PDF_SERVICE_INTERNAL_TOKEN=
