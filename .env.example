# =============================================================================
# Seerah — Environment Variables (example)
# Copy to `.env.local` (Next.js apps) or `.env` (services) and fill in values.
# Never commit real secrets to source control.
# =============================================================================

# ----- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=سيرة

# ----- Supabase (PostgreSQL + Auth + Storage + Realtime) --------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- OpenAI (AI engine) --------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_REQUEST_TIMEOUT_S=60

# ----- Stripe (subscriptions / billing) ------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Either a single price id used for both currencies, OR a per-currency pair.
STRIPE_PRIME_PRICE_ID=
STRIPE_PRIME_PRICE_ID_SAR=
STRIPE_PRIME_PRICE_ID_USD=

# ----- Paddle (MENA payments fallback) -------------------------------------
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRIME_PRICE_ID=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# ----- Upstash Redis (cache / rate limiting) -------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- Inngest (background jobs / queue) -----------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ----- Sentry (error tracking) ---------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ----- PostHog (product analytics) -----------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ----- AI service (FastAPI) ------------------------------------------------
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_INTERNAL_TOKEN=
AI_RATE_LIMIT_FREE=10
AI_RATE_LIMIT_PRIME=100
AI_CORS_ALLOW_ORIGINS=http://localhost:3000

# ----- PDF service (FastAPI + Playwright) ----------------------------------
PDF_SERVICE_URL=http://localhost:8002
PDF_SERVICE_INTERNAL_TOKEN=
EXPORT_LIMIT_FREE_PER_DAY=5
EXPORT_LIMIT_PRIME_PER_DAY=10000
# Bearer token the PDF service presents to the Next render route at
# /render/[id]. Generate any unguessable string; share between web + PDF.
RENDER_INTERNAL_TOKEN=

# ----- Resend (transactional email) ----------------------------------------
# Get a key at https://resend.com/api-keys after verifying your sender
# domain. RESEND_FROM_EMAIL must be on a verified domain (or use
# `onboarding@resend.dev` for tests).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Seerah <noreply@seerah.com>

# ----- Cron (Vercel Scheduled Functions) -----------------------------------
# Random secret Vercel sends as `Authorization: Bearer $CRON_SECRET` on
# scheduled cron invocations. Used by /api/cron/expiring-subscriptions.
CRON_SECRET=

# ----- Admin app → web internal endpoints ----------------------------------
# Bearer token the admin app presents to /api/admin/support/resolve and
# similar internal routes. Same value on both sides.
ADMIN_INTERNAL_TOKEN=

# ----- Admin app — first-run bootstrap -------------------------------------
# Used ONLY by `pnpm --filter @seerah/admin bootstrap` to create the first
# super_admin row. Delete from the env after the script has run.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ----- Admin app — session cookie signing key -------------------------------
# 32 bytes of randomness, hex-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
