<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules (Android 12+).

  We disable BOTH device-to-device transfers and cloud backups for every
  domain.  The Hive boxes (`outbox`, `resume_cache`, `settings`) hold
  PII (name, phone, address, biometric opt-in) in plaintext, and the
  Supabase gotrue session is stored on disk too — none of it should
  leave the device automatically.

  Pair with `android:allowBackup="false"` in the manifest; this file
  takes precedence on API 31+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
