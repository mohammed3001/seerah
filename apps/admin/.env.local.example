# =============================================================================
# apps/admin/.env.local.example
# Copy to apps/admin/.env.local and fill in.  This file is committed; the real
# .env.local must NEVER be committed.
# =============================================================================

# ---- Supabase (same project as apps/web) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App origins -----------------------------------------------------------
# Public URL of the admin panel.  Used by the same-origin CSRF guard
# (apps/admin/src/lib/security/origin.ts) and is allowlisted by the
# admin's own request URL automatically, so leaving it empty does NOT
# break logout — it only matters when you front the admin with a CDN
# that strips the Host header.
ADMIN_APP_URL=http://localhost:3001

# Public URL of the web app.  Allowlisted in the admin CSP `connect-src`
# so the admin can call the web's internal /api/admin/support/notify-*
# endpoints, and used to build email links in support replies.
WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Admin session cookie (PR-A2) ------------------------------------------
# 32 bytes of randomness, hex-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ---- Bootstrap-only (delete after first run) -------------------------------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
